<Window x:Class="DesktopLyric.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopLyric.Views"
        Title="Desktop Lyric"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize"
        FontFamily="Noto Sans HK Medium, Noto Sans HK, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated"
        UseLayoutRounding="False"
        MouseLeftButtonDown="Window_Drag"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 12 buttons used to copy the same look 12 times, one style each kind now -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="#c9cfda"/>
            <Setter Property="BorderBrush" Value="#29FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundPill" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="#a9b2c2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,6">
                            <TextBlock x:Name="Txt" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" ClipToBounds="True" BorderThickness="1"
            BorderBrush="#1AFFFFFF" Background="#0b0b12">

        <Grid Margin="22,14,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <DockPanel Grid.Row="0" Height="38">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource WinButton}" Click="Minimize_Click" ToolTip="縮細"
                            AutomationProperties.Name="縮細">
                        <Path Data="M2.5,7.3 C5.5,6.9 8.5,7.6 11.5,7.1" Stroke="#8b93a3" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource WinButton}" Click="Close_Click" ToolTip="收埋（去 tray 揀結束先會走）"
                            AutomationProperties.Name="收埋">
                        <Path Data="M3,3.3 C5.6,5.7 8.3,8.3 11,10.9 M11,3.1 C8.3,5.7 5.8,8.5 3,11" Stroke="#8b93a3" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Desktop Lyric" FontSize="16" FontWeight="Bold" Foreground="#00d4ff"/>
                    <!-- drawn by hand, a straight line looked too clean -->
                    <Path Data="M1,3.6 C15,2 31,1.6 47,2.4 C65,3.3 85,3 111,0.6" Stroke="#8C00d4ff" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          VerticalAlignment="Bottom" Margin="1,0,0,-7"/>
                </Grid>
            </DockPanel>

            <!-- Now Playing, status moved in here so it is not a row on its own -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="7" Width="64" Height="64"
                        Background="#15FFFFFF" ClipToBounds="True">
                    <Border.CacheMode>
                        <BitmapCache EnableClearType="False" SnapsToDevicePixels="True"/>
                    </Border.CacheMode>
                    <Image x:Name="AlbumArt" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TxtTitle" Text="waiting..."
                               Foreground="#f0f0f5" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtArtist" Text=""
                               Foreground="#a9b2c2" FontSize="12.5" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="TxtTime" DockPanel.Dock="Right" Text=""
                                   Foreground="#8b93a3" FontSize="11" FontFamily="Consolas"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                     Fill="#333" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatus" Text="not connected"
                                       Foreground="#8b93a3" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="#14FFFFFF" Margin="0,14,0,0"/>

            <!-- Lyrics, no card around it anymore -->
            <Grid Grid.Row="3" Margin="0,6">
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="1.25" EnableClearType="False" SnapsToDevicePixels="False"/>
                </Grid.CacheMode>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPrev" Text=""
                               FontSize="12" Foreground="#59FFFFFF"
                               TextAlignment="Center" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtRomaji" Text=""
                               FontSize="10.5" Foreground="#5090c0"
                               TextAlignment="Center" FontStyle="Italic"
                               Margin="0,0,0,3"/>
                    <local:LyricLineView x:Name="TxtCurrent" FontSize="20" IsCurrent="True"
                                         MinHeight="28" Margin="0,2,0,2"/>
                    <local:LyricLineView x:Name="TxtTrans" FontSize="15"
                                         Foreground="#a9b2c2" MinHeight="22" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtNext" Text=""
                               FontSize="12" Foreground="#59FFFFFF"
                               TextAlignment="Center" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Height="1" Background="#14FFFFFF"/>

            <!-- what you touch most is biggest: quick settings first -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnTrad" Style="{StaticResource Pill}" Content="繁體"
                        Click="ToggleTraditional_Click" Foreground="#00d4ff"
                        ToolTip="譯文用繁體（香港用字）"/>
                <Button x:Name="BtnFont" Style="{StaticResource Pill}" Content="昭源圓體"
                        Click="CycleFont_Click" ToolTip="切換中文字型"/>
                <Button x:Name="BtnOverlay" Style="{StaticResource Pill}" Content="overlay on"
                        Click="ToggleOverlay_Click" ToolTip="開／收桌面歌詞"/>
            </StackPanel>

            <DockPanel Grid.Row="6" Margin="0,10,0,0" LastChildFill="False">
                <TextBlock Text="歌詞時間" Foreground="#a9b2c2" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="歌詞早咗撳 −，遲咗撳 ＋；撳一下 0.05s，長按加快"/>
                <Button Content="−" Style="{StaticResource RoundPill}"
                        PreviewMouseLeftButtonDown="OffsetLater_Down"
                        PreviewMouseLeftButtonUp="OffsetHold_Up"
                        LostMouseCapture="OffsetHold_Up"
                        ToolTip="歌詞早咗：延遲。撳一下 0.05s，長按加快（最多 ±5 分鐘）"/>
                <Button x:Name="BtnOffset" Content="±0.00s" Click="OffsetReset_Click"
                        Style="{StaticResource Pill}" BorderBrush="Transparent"
                        Foreground="#a0b0c0" FontFamily="Consolas" Margin="2,0" MinWidth="64"
                        ToolTip="重設呢首歌嘅偏移同快慢"/>
                <Button Content="＋" Style="{StaticResource RoundPill}"
                        PreviewMouseLeftButtonDown="OffsetEarlier_Down"
                        PreviewMouseLeftButtonUp="OffsetHold_Up"
                        LostMouseCapture="OffsetHold_Up"
                        ToolTip="歌詞遲咗：提早。撳一下 0.05s，長按加快（最多 ±5 分鐘）"/>
                <Button DockPanel.Dock="Right" Content="選歌" Click="PickSong_Click"
                        Style="{StaticResource Pill}" Height="38" Padding="18,0" Margin="0"
                        FontSize="13" BorderBrush="#00d4ff" Foreground="#00d4ff"
                        ToolTip="同名歌揀正確版本"/>
            </DockPanel>

            <WrapPanel Grid.Row="7" Margin="0,8,0,0">
                <Button Content="記憶" Style="{StaticResource Link}" Click="SavedSongs_Click"
                        ToolTip="檢視、改揀或刪除已記住嘅歌詞"/>
                <Button Content="時機" Style="{StaticResource Link}" Click="TimingEditor_Click"
                        ToolTip="時機編輯：偏移＋快慢＋改詞＋停留（適合 YouTube Live）"/>
                <Button Content="全屏" Style="{StaticResource Link}" Click="Fullscreen_Click"
                        ToolTip="專輯版面／全幕歌詞（F11）"/>
                <Button Content="export lrc" Style="{StaticResource Link}" Click="ExportLrc_Click"/>
                <Button Content="設定" Style="{StaticResource Link}" Click="Settings_Click"
                        ToolTip="顯示、overlay、字級、開機啟動"/>
            </WrapPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="8" Margin="0,4,0,0">
                <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Text="" Foreground="#7b8394" FontSize="10"/>
                <TextBlock Text="made by Epi-Lo" Foreground="#7b8394" FontSize="10"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
