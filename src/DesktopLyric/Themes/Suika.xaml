<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 萃香 fan theme. green is taken from the art background, red from her bow -->
    <SolidColorBrush x:Key="WindowBg" Color="#afcea5"/>
    <SolidColorBrush x:Key="WindowBorder" Color="#2E2b1d2a"/>
    <SolidColorBrush x:Key="Text" Color="#2b1d2a"/>
    <SolidColorBrush x:Key="SubText" Color="#3b2b3c"/>
    <SolidColorBrush x:Key="MetaText" Color="#3b2b3c"/>
    <SolidColorBrush x:Key="FooterText" Color="#2b1d2a"/>
    <SolidColorBrush x:Key="Faint" Color="#992b1d2a"/>
    <SolidColorBrush x:Key="Romaji" Color="#5a3d8a"/>
    <SolidColorBrush x:Key="TransText" Color="#5a3d8a"/>
    <SolidColorBrush x:Key="Line" Color="Transparent"/>
    <SolidColorBrush x:Key="Accent" Color="#b8372c"/>
    <SolidColorBrush x:Key="AccentFaint" Color="#8Cb8372c"/>
    <SolidColorBrush x:Key="OffText" Color="#4e3d52"/>
    <SolidColorBrush x:Key="PillText" Color="#2b1d2a"/>
    <SolidColorBrush x:Key="PillBg" Color="#fffaf2"/>
    <SolidColorBrush x:Key="PillBorder" Color="#242b1d2a"/>
    <SolidColorBrush x:Key="PillHover" Color="#fff3e3"/>
    <SolidColorBrush x:Key="PillPressed" Color="#f0e6da"/>
    <SolidColorBrush x:Key="LinkHover" Color="#b8372c"/>
    <!-- buttons sit on top of the art, need a bit of paper behind -->
    <SolidColorBrush x:Key="WinButtonBg" Color="#CCfffaf2"/>
    <SolidColorBrush x:Key="WinButtonHover" Color="#fffaf2"/>
    <!-- red dot looked like an error -->
    <SolidColorBrush x:Key="StatusOn" Color="#2b7a52"/>
    <SolidColorBrush x:Key="AlbumBg" Color="#fffaf2"/>
    <SolidColorBrush x:Key="LyricsCardBg" Color="#fffaf2"/>
    <SolidColorBrush x:Key="LyricsCardBorder" Color="#242b1d2a"/>

    <Visibility x:Key="ArtVisibility">Visible</Visibility>
    <!-- song text stays left of the picture -->
    <sys:Double x:Key="NowPlayingMaxWidth">230</sys:Double>
    <sys:Double x:Key="NowPlayingHeight">150</sys:Double>

    <!-- overlay: cream paper picture with 萃香 sitting on the right.
         lyrics get a big right margin so they never sit on top of her -->
    <SolidColorBrush x:Key="OverlayRim" Color="#1F000000"/>
    <ImageBrush x:Key="OverlayPlate" ImageSource="/Assets/suika-overlay.png"
                Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
    <SolidColorBrush x:Key="OverlayEdge" Color="#3D2b1d2a"/>
    <Thickness x:Key="OverlayEdgeWidth">1.5</Thickness>
    <SolidColorBrush x:Key="OverlayNote" Color="#b8372c"/>
    <SolidColorBrush x:Key="OverlayTitle" Color="#2b1d2a"/>
    <SolidColorBrush x:Key="OverlayDot" Color="#802b1d2a"/>
    <SolidColorBrush x:Key="OverlayArtist" Color="#4e3d52"/>
    <SolidColorBrush x:Key="OverlayTrans" Color="#5a3d8a"/>
    <SolidColorBrush x:Key="OverlayNext" Color="#6b5c6a"/>
    <!-- buttons sit on the grass part of the picture, need paper behind -->
    <SolidColorBrush x:Key="OverlayBar" Color="#E6f3eadf"/>
    <SolidColorBrush x:Key="OverlayButton" Color="#2b1d2a"/>
    <SolidColorBrush x:Key="OverlayClose" Color="#4e3d52"/>
    <SolidColorBrush x:Key="OverlayOn" Color="#b8372c"/>
    <SolidColorBrush x:Key="OverlayOff" Color="#6b5c6a"/>
    <Thickness x:Key="OverlayLyricsMargin">16,4,150,4</Thickness>
</ResourceDictionary>
