<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- main window colours, same as 1.1.0 -->
    <SolidColorBrush x:Key="WindowBg" Color="#0b0b12"/>
    <SolidColorBrush x:Key="WindowBorder" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#f0f0f5"/>
    <SolidColorBrush x:Key="SubText" Color="#a9b2c2"/>
    <SolidColorBrush x:Key="MetaText" Color="#8b93a3"/>
    <SolidColorBrush x:Key="FooterText" Color="#7b8394"/>
    <SolidColorBrush x:Key="Faint" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="Romaji" Color="#5090c0"/>
    <SolidColorBrush x:Key="TransText" Color="#a9b2c2"/>
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#00d4ff"/>
    <SolidColorBrush x:Key="AccentFaint" Color="#8C00d4ff"/>
    <SolidColorBrush x:Key="OffText" Color="#a0b0c0"/>
    <SolidColorBrush x:Key="PillText" Color="#c9cfda"/>
    <SolidColorBrush x:Key="PillBg" Color="Transparent"/>
    <SolidColorBrush x:Key="PillBorder" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="PillHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="PillPressed" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="LinkHover" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WinButtonBg" Color="Transparent"/>
    <SolidColorBrush x:Key="WinButtonHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="StatusOn" Color="#00d4ff"/>
    <SolidColorBrush x:Key="AlbumBg" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="LyricsCardBg" Color="Transparent"/>
    <SolidColorBrush x:Key="LyricsCardBorder" Color="Transparent"/>

    <Visibility x:Key="ArtVisibility">Collapsed</Visibility>
    <sys:Double x:Key="NowPlayingMaxWidth">10000</sys:Double>
    <sys:Double x:Key="NowPlayingHeight">64</sys:Double>

    <!-- overlay, same look as 1.2.0 -->
    <SolidColorBrush x:Key="OverlayRim" Color="#55000000"/>
    <SolidColorBrush x:Key="OverlayPlate" Color="#080810" Opacity="0.88"/>
    <LinearGradientBrush x:Key="OverlayEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2000d4ff" Offset="0"/>
        <GradientStop Color="#08FFFFFF" Offset="0.5"/>
        <GradientStop Color="#1500d4ff" Offset="1"/>
    </LinearGradientBrush>
    <Thickness x:Key="OverlayEdgeWidth">0.8</Thickness>
    <SolidColorBrush x:Key="OverlayNote" Color="#4000d4ff"/>
    <SolidColorBrush x:Key="OverlayTitle" Color="#80e0e8f4"/>
    <SolidColorBrush x:Key="OverlayDot" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="OverlayArtist" Color="#507090a0"/>
    <SolidColorBrush x:Key="OverlayUnsung" Color="#F0F4F8"/>
    <SolidColorBrush x:Key="OverlayTrans" Color="#C8DDE8"/>
    <SolidColorBrush x:Key="OverlayNext" Color="#70A0B0C0"/>
    <SolidColorBrush x:Key="OverlayBar" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="OverlayButton" Color="#90FFFFFF"/>
    <SolidColorBrush x:Key="OverlayClose" Color="#60FFFFFF"/>
    <SolidColorBrush x:Key="OverlayOn" Color="#00d4ff"/>
    <SolidColorBrush x:Key="OverlayOff" Color="#909090"/>
    <Thickness x:Key="OverlayLyricsMargin">16,4,16,4</Thickness>
</ResourceDictionary>
